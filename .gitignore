# CodeIgniter cache & logs
/application/logs/*
!/application/logs/.gitkeep
/application/cache/*
!/application/cache/sessions/
/application/cache/sessions/*
!/application/cache/sessions/.gitkeep
!/application/cache/.gitkeep

# Uploads (user uploaded documents)
/uploads/*
!/uploads/.htaccess
!/uploads/temp/
!/uploads/temp/.gitkeep
!/uploads/ssh_sbu/
!/uploads/ssh_sbu/.gitkeep

# Sensitive environment configs
database.local.php
application/config/database.local.php
*.env
.env

# Deploy archives, DB dumps, spreadsheets & OS files
*.zip
*.tar.gz
*.sql
!database/migrations/*.sql
*.xlsx
*.xls
*.csv
!vendor/**
.DS_Store
Thumbs.db

