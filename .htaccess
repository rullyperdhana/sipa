# Matikan directory browsing untuk keamanan
Options -Indexes

# Blokir akses langsung ke file sensitif dan tersembunyi
<FilesMatch "(^\..*|\.env|\.sql|\.json|\.lock|\.log|database\.local\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir akses langsung ke folder application dan system
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(application|system) - [F,L]

    # If the request is for a real file or directory, don't rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>