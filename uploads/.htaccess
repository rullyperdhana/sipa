# Mencegah eksekusi file script di dalam direktori uploads
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|sh|bash|exe|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
